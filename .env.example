# Copy to .env.local and add your key. It stays on the server; the browser only gets short-lived Realtime session keys.
OPENAI_API_KEY=

# Optional overrides (change if OpenAI renames models)
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_VOICE=marin
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TEXT_MODEL=gpt-6-astra
# WEB_SEARCH=on
# OPENAI_BASE_URL=https://api.openai.com/v1
